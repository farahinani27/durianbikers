      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(composer *)",
      "Bash(wp *)",
      "Bash(git status)",
      "Bash(git diff *)",
