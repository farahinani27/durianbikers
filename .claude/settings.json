      "Bash(wp db reset *)",
      "Bash(wp db import *)",
      "Bash(wp site empty *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl * --data *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./wp-config.php)",
      "Edit(./wp-config.php)"
